        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="登录" enabled="true">
            <stringProp name="BeanShellSampler.query">package com.easemob.im.call;
import com.easemob.im.*;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

String appKey = &quot;${org_name}#${app_name}&quot;;
String url = &quot;tcp://${msync_host}:${msync_port}&quot;;
//String username = &quot;${prename}${__BeanShell(${__threadNum}-1+1000,)}&quot;;
String username = &quot;${prename}${__threadNum}&quot;;
String password = &quot;${user_password}&quot;;
String s = Call.getInstance(appKey, url).create(username, password);

String s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
log.info(&quot;login:&quot;+username+s1);
if(!s1.equals(&quot;success&quot;)){
	log.info(&quot;login:&quot;+s1);
	IsSuccess = false;
	ResponseCode = 500;
	for(int i=0;i&lt;3;i++)
	{
		s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
		//log.info(&quot;login:&quot;+username+&quot;:&quot;+password+&quot;:&quot;+s1);
		if(s1.equals(&quot;success&quot;))
		{
			IsSuccess = true;
			ResponseCode = 200;
			break;	
		}
	}
}
</stringProp>
          </BeanShellSampler>
          <hashTree/>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="登录" enabled="false">
            <stringProp name="BeanShellSampler.query">package com.easemob.im.call;
import com.easemob.im.*;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

String appKey = &quot;${org_name}#${app_name}&quot;;
String url = &quot;tcp://${msync_host}:${msync_port}&quot;;
//String username = &quot;${prename}${__BeanShell(${__threadNum}-1+1000,)}&quot;;
String username = &quot;${prename}17&quot;;
String password = &quot;${user_password}&quot;;
String s = Call.getInstance(appKey, url).create(username, password);

String s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
log.info(&quot;login:&quot;+username+s1);
if(!s1.equals(&quot;success&quot;)){
	log.info(&quot;login:&quot;+s1);
	IsSuccess = false;
	ResponseCode = 500;
	for(int i=0;i&lt;3;i++)
	{
		s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
		//log.info(&quot;login:&quot;+username+&quot;:&quot;+password+&quot;:&quot;+s1);
		if(s1.equals(&quot;success&quot;))
		{
			IsSuccess = true;
			ResponseCode = 200;
			break;	
		}
	}
}
</stringProp>
