          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">package com.easemob.im.call;
import com.easemob.im.*;
import java.util.HashMap;
import java.util.Map;

import com.alibaba.fastjson.JSON;
import com.alibaba.fastjson.JSONObject;

String appKey = &quot;${org_name}#${app_name}&quot;;
String url = &quot;tcp://${msync_host}:${msync_port}&quot;;
String from = &quot;${prename}${__threadNum}&quot;;
String username = &quot;${prename}${__threadNum}&quot;;
String password = &quot;${user_password}&quot;;

String s2 = Call.getInstance(appKey, url).receive(from, ${msync_receive_timeout});

//log.info(from + &quot;receivemsg:&quot; + s2);
if(s2.equals(&quot;error&quot;) || s2.equals(&quot;not user&quot;)){
	String s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
	log.info(&quot;relogin:&quot;+username+s1);
	if(!s1.equals(&quot;success&quot;)){
		log.info(&quot;login:&quot;+s1);
		IsSuccess = false;
		ResponseCode = 500;
		for(int i=0;i&lt;3;i++)
		{
			s1 = Call.getInstance(appKey, url).login(username, password, ${msync_connect_timeout});
			//log.info(&quot;login:&quot;+username+&quot;:&quot;+password+&quot;:&quot;+s1);
			if(s1.equals(&quot;success&quot;))
			{
				IsSuccess = true;
				ResponseCode = 200;
				break;	
			}
		}
	}
}</stringProp>
          </BeanShellPreProcessor>
