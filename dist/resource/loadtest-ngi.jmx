        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取App-token">
          <stringProp name="HTTPSampler.domain">${host}</stringProp>
          <stringProp name="HTTPSampler.port">${rest2_port}</stringProp>
          <stringProp name="HTTPSampler.protocol">${rest2_schema}</stringProp>
          <stringProp name="HTTPSampler.path">/${org_name}/${app_name}/token</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
    &quot;grant_type&quot;: &quot;client_credentials&quot;,&#xd;
    &quot;client_id&quot;: &quot;${client_id}&quot;,&#xd;
    &quot;client_secret&quot;: &quot;${client_secret}&quot;,&#xd;
    &quot;ttl&quot;:150000000&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="OK" enabled="true">
            <stringProp name="BeanShellAssertion.query">import org.json.*;
import java.util.*;

String respString = new String(ResponseData, Response.getDataEncodingWithDefault());
if (!&quot;200&quot;.equals(ResponseCode)) {
	Failure = true;
	FailureMessage = ResponseCode + &quot;, &quot; + respString;
	return;
}
</stringProp>
            <stringProp name="BeanShellAssertion.filename"></stringProp>
            <stringProp name="BeanShellAssertion.parameters"></stringProp>
            <boolProp name="BeanShellAssertion.resetInterpreter">true</boolProp>
          </BeanShellAssertion>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="App-token-extractor" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">app_token</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">${__setProperty(app_token,${app_token},)};</stringProp>
          </BeanShellPostProcessor>
          <hashTree/>
        </hashTree>
